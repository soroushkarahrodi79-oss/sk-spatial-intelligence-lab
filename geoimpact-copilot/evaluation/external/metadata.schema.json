{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sk-spatial-intelligence-lab.invalid/schemas/external-report-metadata.schema.json",
  "title": "Sidecar metadata for an external, rights-cleared GeoImpact-CI report",
  "description": "An external report is evaluated only when this file sits beside it as NAME.meta.json for NAME.report.json. No real report is shipped with the repository; this is the contract for ones a reviewer supplies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_file", "report_sha256", "split", "source_provenance", "dataset_rights", "human_review", "independent_labels", "uncertainty_notes"],
  "properties": {
    "report_file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.report\\.json$" },
    "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "split": { "enum": ["development", "held_out"] },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "producer_version", "produced_on", "input_description"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "producer_version": { "type": "string", "minLength": 1 },
        "produced_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "input_description": { "type": "string", "minLength": 1 },
        "input_hashes_verified": { "type": "boolean" }
      }
    },
    "dataset_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "evidence_url", "redistribution_allowed", "contains_personal_data"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "evidence_url": { "type": "string", "pattern": "^https://" },
        "redistribution_allowed": { "const": true },
        "contains_personal_data": { "const": false }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["unreviewed", "in_review", "reviewed"] },
        "reviewer_roles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reviewed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "second_reviewer_agreement": { "enum": ["agreed", "disagreed", "not_applicable"] }
      },
      "if": { "properties": { "status": { "const": "reviewed" } } },
      "then": { "required": ["reviewer_roles", "reviewed_on", "second_reviewer_agreement"] }
    },
    "independent_labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "expected_decision", "labeled_by"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "expected_decision": { "enum": ["ANSWER", "ABSTAIN"] },
          "expected_reason": { "type": "string" },
          "expected_contains": { "type": "array", "items": { "type": "string" } },
          "expected_not_contains": { "type": "array", "items": { "type": "string" } },
          "expected_facts": {
            "type": "array",
            "items": { "type": "object", "required": ["path", "value"], "additionalProperties": false, "properties": { "path": { "type": "string", "pattern": "^#/" }, "value": {} } }
          },
          "labeled_by": { "enum": ["domain_expert", "report_producer", "independent_reviewer"] }
        }
      }
    },
    "uncertainty_notes": { "type": "string", "minLength": 1 }
  }
}
