{
  "name": "sk-spatial-intelligence-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Validation tooling for the static research site and local deterministic GeoImpact evidence prototype.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "npm run validate:html && node scripts/validate.mjs",
    "validate:html": "html-validate space/index.html",
    "check:links": "node scripts/check-links.mjs",
    "plan:space": "node scripts/space-plan.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "copilot": "node geoimpact-copilot/cli.mjs",
    "test:copilot": "node --test tests/geoimpact-copilot.test.mjs tests/geoimpact-semantic.test.mjs tests/geoimpact-review-lifecycle.test.mjs tests/geoimpact-readiness.test.mjs",
    "evaluate:copilot": "node geoimpact-copilot/evaluate.mjs",
    "test": "npm run validate && npm run test:copilot && npm run check:skeletons && npm run check:review-checklist && npm run check:review-record && npm run check:review-packet && npm run check:test-set && npm run check:sonnet-prerequisites && npm run evaluate:copilot && npm run evaluate:copilot:v2 && npm run check:links && npm run test:browser",
    "evaluate:copilot:v2": "node geoimpact-copilot/evaluation/run-v2.mjs",
    "check:skeletons": "node geoimpact-copilot/semantic/build-skeletons.mjs --check",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=geoimpact-copilot/lib/** --test-coverage-include=geoimpact-copilot/provider-contract/** tests/geoimpact-copilot.test.mjs tests/geoimpact-semantic.test.mjs tests/geoimpact-review-lifecycle.test.mjs",
    "check:review-checklist": "node geoimpact-copilot/semantic/build-review-checklist.mjs --check",
    "check:review-record": "node geoimpact-copilot/semantic/check-review.mjs",
    "check:review-packet": "node geoimpact-copilot/semantic/build-review-packet.mjs --check",
    "check:test-set": "node geoimpact-copilot/evaluation/independent-test-set/check-test-set.mjs",
    "check:sonnet-prerequisites": "node geoimpact-copilot/provider-contract/check-sonnet-prerequisites.mjs",
    "check:intake": "node geoimpact-copilot/evaluation/external/intake.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "css-tree": "3.2.1",
    "html-validate": "11.17.0",
    "playwright": "1.64.1",
    "yaml": "2.9.1"
  }
}
